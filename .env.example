# Supabase (공지사항/기업/문의/팝업 데이터 저장소)
# 값이 비어 있으면 브라우저 localStorage 모드로 동작하며, 다른 방문자에게 데이터가 공유되지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오맵 JavaScript 키 (https://developers.kakao.com)
# JavaScript SDK 도메인: http://localhost:3000 , Vercel 미리보기, https://holdings.tukorea.ac.kr
VITE_KAKAO_JS_KEY=

# Resend (문의 메일 발송 — 서버 전용, VITE_ 접두사 붙이지 말 것)
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=tuholdings@tukorea.ac.kr
# 인증된 발신 도메인 주소. holdings.tukorea.ac.kr DNS 인증 후 아래를 그 주소로 바꾸면 된다.
RESEND_FROM=한국공학대학교 기술지주회사 <noreply@namhyeondong.com>
